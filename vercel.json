{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/build/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "^/(.*)",
      "dest": "api/index.php"
    }
  ]
}
